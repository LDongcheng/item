/* pages/login/index.wxss */
page {
  --primary: #2563EB;
  --primary-light: #60A5FA;
  --text-primary: #1F2937;
  --text-secondary: #6B7280;
}

.login-container {
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #DBEAFE 0%, #60A5FA 50%, #2563EB 100%);
  padding: 64rpx;
}

.login-card {
  width: 100%;
  background: rgba(255, 255, 255, 0.95);
  border-radius: 24rpx;
  padding: 64rpx 48rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 8rpx 32rpx rgba(37, 99, 235, 0.15);
}

.logo-wrap {
  margin-bottom: 32rpx;
}

.logo {
  width: 160rpx;
  height: 160rpx;
}

.title {
  font-size: 44rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 12rpx;
}

.subtitle {
  font-size: 28rpx;
  color: var(--text-secondary);
  margin-bottom: 64rpx;
}

.login-btn {
  width: 100%;
  height: 88rpx;
  background: linear-gradient(90deg, var(--primary) 0%, var(--primary-light) 100%);
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 16rpx rgba(37, 99, 235, 0.3);
}

.login-btn:active {
  transform: scale(0.98);
}

.login-btn.loading {
  opacity: 0.7;
}

.tip-text {
  font-size: 24rpx;
  color: var(--text-secondary);
  margin-top: 32rpx;
}

.tip-text .link {
  color: var(--primary);
}
